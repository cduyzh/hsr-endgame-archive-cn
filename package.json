{
  "name": "hsr-endgame-archive-cn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 32200",
    "build": "run-p typecheck test:unit lint build:only",
    "build:only": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 39201",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "netlify:login": "mkdir -p .netlify-config && XDG_CONFIG_HOME=\"$PWD/.netlify-config\" pnpm --package=netlify-cli dlx netlify login",
    "deploy:netlify": "sh ./scripts/deploy-netlify.sh",
    "sync:units": "node scripts/sync-hsr-units.mjs",
    "sync:monsters": "node scripts/sync-hsr-monsters.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "lucide-vue-next": "^0.475.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@netlify/functions": "^3.0.0",
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.10.7",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-typescript": "^14.3.0",
    "@vue/tsconfig": "^0.7.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^25.0.1",
    "npm-run-all2": "^7.0.2",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=24"
  }
}
